# Database Configuration (Neon Free — empty DBs; apply Prisma migrations)
DATABASE_URL="your-assessment-database-url"
USER_DATABASE="your-user-database-url"
DIRECT_URL="your-direct-database-url"

# Authentication
NEXTAUTH_SECRET="your-secret"
NEXTAUTH_URL="http://localhost:3000"
PREVIEW_LOGIN_EMAIL="preview@example.com"
PREVIEW_LOGIN_PASSWORD="use-a-long-random-password"
PREVIEW_LOGIN_NAME="Preview User"

# Base URL Configuration (optional)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
TEST_BASE_URL=http://localhost:3000

# Intercom (parked for pilot — leave empty)
NEXT_PUBLIC_INTERCOM_APP_ID=

# Submission Configuration
NEXT_PUBLIC_SUBMISSION_DOMAIN=localhost

# Domain Configuration
DEMO_DOMAIN=localhost
DEV_DOMAIN=localhost

# Demo Mode Configuration
DEMO_MODE=false
DEMO_MODE_MESSAGE=""
DEMO_READ_ONLY=false
DEMO_ASSESSMENT_ID=
DEMO_TENANT_ID=

# Demo teacher credentials (seed: pnpm db:seed:demo). Domain must be demo.dott.it
DEMO_TEACHER_EMAIL=teacher@demo.dott.it
DEMO_TEACHER_PASSWORD=replace-me
# Optional: local/preview-only shortcut (NODE_ENV=development or VERCEL_ENV=preview)
PREVIEW_LOGIN_EMAIL=teacher@demo.dott.it
PREVIEW_LOGIN_PASSWORD=replace-me
PREVIEW_LOGIN_NAME=Demo Teacher

# Test Configuration
TEST_ONLINE=0
SKIP_LINK_CHECKER=0
LINK_CHECKER_TIMEOUT=30000
VERBOSE=0

# Vercel Configuration (for deployment)
VERCEL_AUTOMATION_BYPASS_SECRET="your-vercel-secret"

# Hash Salt for Anonymization
HASH_SALT="your-hash-salt"

# API Configuration
API_URL="http://localhost:3000"

# Mock API Configuration
MOCK_API_ENABLED=false
MOCK_API_PATH="/api"
MOCK_API_PROXY_URL="https://your-api-server.com"
MOCK_API_PROXY_API_URL="https://your-api-server.com"
